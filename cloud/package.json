{
  "name": "exilelens-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ExileLens Cloudflare Worker (Package A: opt-in usage statistics and error reports; Package B: Patreon OAuth + entitlement leases)",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply TELEMETRY_DB --local",
    "report": "node scripts/report.mjs",
    "migrate:patreon:local": "wrangler d1 migrations apply PATREON_DB --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  }
}
