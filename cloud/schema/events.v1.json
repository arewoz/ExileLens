{
  "schema_version": 1,
  "consent_version": 1,
  "title": "ExileLens cloud contract v1 (usage statistics and error reports)",
  "limits": {
    "batch_max_bytes": 32768,
    "usage_batch_max_events": 100,
    "error_batch_max_reports": 20,
    "max_event_age_hours": 192,
    "max_future_hours": 1,
    "usage_daily_events_per_install": 500,
    "error_daily_reports_per_install": 60,
    "client_queue_max_events": 500,
    "client_queue_max_bytes": 262144,
    "client_queue_ttl_hours": 168
  },
  "types": {
    "version": { "kind": "pattern", "regex": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}(b[0-9]{1,3})?$", "max_len": 16 },
    "hour": { "kind": "pattern", "regex": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00Z$", "max_len": 17 },
    "uuid": { "kind": "pattern", "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "max_len": 36 },
    "el_code": { "kind": "pattern", "regex": "^EL-[A-Z]{2,4}-[0-9]{3}$", "max_len": 12 },
    "identifier": { "kind": "pattern", "regex": "^[A-Za-z_][A-Za-z0-9_.]{0,79}$", "max_len": 80 },
    "duration_bucket": { "kind": "enum", "values": ["lt_1s", "lt_5s", "lt_15s", "lt_60s", "ge_60s"] },
    "latency_bucket": { "kind": "enum", "values": ["lt_250ms", "lt_500ms", "lt_1s", "lt_2s", "lt_5s", "ge_5s"] },
    "component": {
      "kind": "enum",
      "values": ["APP", "POB", "BLD", "CHK", "WRK", "KEY", "UI", "UPD", "DIAG", "SVC", "PAT"]
    }
  },
  "app": {
    "required": ["version", "channel", "packaged", "os"],
    "props": {
      "version": { "ref": "version" },
      "channel": { "kind": "enum", "values": ["stable", "beta"] },
      "packaged": { "kind": "bool" },
      "os": { "kind": "enum", "values": ["win10", "win11", "other"] }
    }
  },
  "usage": {
    "id_field": "analytics_id",
    "envelope_extra": {
      "queue_dropped": { "kind": "int", "min": 0, "max": 100000 }
    },
    "events": {
      "app_started": {
        "description": "The app started (once per launch), and how the previous session ended.",
        "required": ["launch", "previous_session", "pob_configured"],
        "props": {
          "launch": { "kind": "enum", "values": ["normal", "after_update", "after_update_failed"] },
          "previous_session": { "kind": "enum", "values": ["clean", "unexpected", "first_run", "unknown"] },
          "pob_configured": { "kind": "bool" }
        }
      },
      "onboarding_completed": {
        "description": "First-run setup was finished or skipped.",
        "required": ["outcome", "pob_autodetected"],
        "props": {
          "outcome": { "kind": "enum", "values": ["finished", "skipped"] },
          "pob_autodetected": { "kind": "bool" }
        }
      },
      "pob_connected": {
        "description": "Whether the Path of Building engine started (once per launch).",
        "required": ["outcome", "boot"],
        "props": {
          "outcome": { "kind": "enum", "values": ["ready", "failed"] },
          "error_code": { "ref": "el_code" },
          "boot": { "kind": "enum", "values": ["lt_2s", "lt_5s", "lt_15s", "lt_60s", "ge_60s"] }
        }
      },
      "item_checks_summary": {
        "description": "Counts of Item Check results since the last upload, grouped by category. Never the items themselves.",
        "required": ["buckets"],
        "props": {
          "buckets": {
            "kind": "list",
            "max_items": 60,
            "item": {
              "required": ["verdict", "confidence", "quality", "latency", "outcome", "n"],
              "props": {
                "verdict": {
                  "kind": "enum",
                  "values": [
                    "meaningful_upgrade", "minor_upgrade", "sidegrade", "minor_downgrade",
                    "meaningful_downgrade", "not_viable", "uncertain", "unsupported", "not_evaluated"
                  ]
                },
                "confidence": { "kind": "enum", "values": ["high", "medium", "low", "none"] },
                "quality": { "kind": "enum", "values": ["full", "partial", "unsupported", "failed", "none"] },
                "latency": { "ref": "latency_bucket" },
                "outcome": { "kind": "enum", "values": ["ok", "error"] },
                "n": { "kind": "int", "min": 1, "max": 10000 }
              }
            }
          }
        }
      },
      "analyze_build_completed": {
        "description": "An Analyze Build run finished: only whether it worked and how complete it was, never the results.",
        "required": ["outcome", "coverage", "curve_count", "hard_issue_present", "health", "duration"],
        "props": {
          "outcome": { "kind": "enum", "values": ["ok", "error", "no_signal"] },
          "coverage": { "kind": "enum", "values": ["high", "partial", "limited", "none"] },
          "curve_count": { "kind": "int", "min": 0, "max": 3 },
          "hard_issue_present": { "kind": "bool" },
          "health": {
            "kind": "enum",
            "values": ["needs_attention", "nearly_capped", "opportunity", "no_urgent_issue", "limited", "none"]
          },
          "duration": { "ref": "duration_bucket" },
          "error_code": { "ref": "el_code" }
        }
      },
      "update_detected": {
        "description": "A newer ExileLens release was found.",
        "required": ["to_version", "verified"],
        "props": {
          "to_version": { "ref": "version" },
          "verified": { "kind": "bool" }
        }
      },
      "update_download_completed": {
        "description": "An update download finished or failed.",
        "required": ["to_version", "mode", "outcome", "duration"],
        "props": {
          "to_version": { "ref": "version" },
          "mode": { "kind": "enum", "values": ["manual", "auto"] },
          "outcome": {
            "kind": "enum",
            "values": ["ok", "hash_mismatch", "size_mismatch", "network", "disk", "cancelled", "other"]
          },
          "duration": { "ref": "duration_bucket" }
        }
      },
      "update_install_completed": {
        "description": "The result of the previous update installation, reported on the next launch.",
        "required": ["from_version", "to_version", "mode", "outcome"],
        "props": {
          "from_version": { "ref": "version" },
          "to_version": { "ref": "version" },
          "mode": { "kind": "enum", "values": ["restart", "no_restart", "recover"] },
          "outcome": {
            "kind": "enum",
            "values": [
              "success", "relaunch_failed", "invalid_job", "already_running", "process_timeout",
              "prepare_failed", "restored", "restore_failed", "recovered"
            ]
          }
        }
      }
    }
  },
  "errors": {
    "id_field": "diagnostic_id",
    "envelope_extra": {},
    "report": {
      "description": "A structured application error: its registered code and where it happened, never its message.",
      "required": ["error_code", "component", "exception_type", "frames", "count", "first_t", "last_t"],
      "props": {
        "error_code": { "ref": "el_code" },
        "component": { "ref": "component" },
        "exception_type": { "ref": "identifier" },
        "frames": {
          "kind": "list",
          "max_items": 12,
          "item": {
            "required": ["module"],
            "props": {
              "module": { "ref": "identifier" },
              "function": { "ref": "identifier" },
              "line": { "kind": "int", "min": 1, "max": 100000 }
            }
          }
        },
        "count": { "kind": "int", "min": 1, "max": 1000 },
        "first_t": { "ref": "hour" },
        "last_t": { "ref": "hour" },
        "pob_version": { "ref": "version" }
      }
    }
  },
  "never_collected": [
    "Item text, item names or modifiers, or anything copied to the clipboard",
    "Build files, PoB data, character or account names, skills, stats or equipment",
    "Trade searches, prices or market data",
    "File paths, log files, settings values or environment variables",
    "Error messages or raw stack traces (only module and function names are sent)",
    "IP addresses are not stored in ExileLens data (the hosting provider still sees them for any web request)",
    "Hardware, Windows account, email, Path of Exile or Patreon identity"
  ],
  "identifiers": {
    "analytics_id": "A random ID created on this PC only when usage statistics are turned on. The server stores only a keyed hash of it. Turning the setting off deletes it; turning it on again creates a new one.",
    "diagnostic_id": "A different random ID created only when error reports are turned on. It is never shared with usage statistics or Patreon."
  },
  "retention": {
    "raw_events_days": 30,
    "install_activity_days": 120,
    "aggregates_months": 13,
    "error_groups_months": 12,
    "error_install_links_days": 60
  },
  "categories": {
    "usage": {
      "title": "Privacy-friendly usage statistics",
      "summary": "Counts that show whether ExileLens works and is used: app starts, setup, result categories and speed buckets, update outcomes."
    },
    "errors": {
      "title": "Crash and error reports",
      "summary": "A registered error code, the component, the exception type and module/function names of where it happened."
    }
  }
}
